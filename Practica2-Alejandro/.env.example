# Plantilla de variables de entorno. Este fichero SI se sube al repositorio
# porque no lleva ningun secreto de verdad. Para ejecutar el proyecto se copia
# a .env y se ajustan los valores:
#
#   cp .env.example .env
#
# .env esta en el .gitignore y no se sube nunca.

# Cadena de conexion a PostgreSQL:
#   postgres://usuario:contrasena@servidor:puerto/nombre_de_la_base
DATABASE_URL=postgres://postgres:postgres@localhost:5432/g247_p2

# Clave con la que se firman y verifican los tokens. En local vale cualquier
# cosa larga; en produccion se genera al azar y no se comparte:
#   openssl rand -hex 32
JWT_SECRET=cambiame-por-una-cadena-larga-y-aleatoria

# Puerto de la API. El cliente de React corre aparte, en el 5173.
PORT=3000
