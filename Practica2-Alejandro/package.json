{
  "name": "practica2-partidos",
  "version": "1.0.0",
  "private": true,
  "description": "Practica 2 - API de partidos sobre PostgreSQL con autenticacion JWT y cliente React. G247 CUNEF.",
  "type": "commonjs",
  "engines": { "node": ">=18" },
  "main": "src/server.js",
  "scripts": {
